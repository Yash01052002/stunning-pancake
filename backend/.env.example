DATABASE_URL=postgresql+psycopg2://ticketing:ticketing@db:5432/ticketing
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FALLBACK_TRIAGE_TEAM_NAME=Triage

# Phase 3: LLM-based auto-triage. AUTO_TRIAGE_ENGINE=rule keeps the default
# behavior; set to "llm" to make Claude the default engine (requires a real
# ANTHROPIC_API_KEY below). Either way, POST /tickets/{id}/triage?engine=
# can invoke a specific engine per ticket regardless of this default.
AUTO_TRIAGE_ENGINE=rule
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_CONFIDENCE_THRESHOLD=0.6
TRIAGE_CATEGORIES_CSV=billing,incident,security,account,general
