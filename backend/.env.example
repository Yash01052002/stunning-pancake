DATABASE_URL=postgresql+psycopg2://ticketing:ticketing@db:5432/ticketing
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FALLBACK_TRIAGE_TEAM_NAME=Triage

# Phase 3: LLM-based auto-triage. AUTO_TRIAGE_ENGINE=rule keeps the default
# behavior; set to "llm" to make Claude the default engine (requires a real
# ANTHROPIC_API_KEY below). Either way, POST /tickets/{id}/triage?engine=
# can invoke a specific engine per ticket regardless of this default.
AUTO_TRIAGE_ENGINE=rule
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_CONFIDENCE_THRESHOLD=0.6
TRIAGE_CATEGORIES_CSV=billing,incident,security,account,general

# Phase 4: SLA timers + notifications. Email and Slack are both optional —
# if unset, those channels are logged and skipped (in-app notifications are
# always created regardless). A ticket is "at risk" once it's within this
# many minutes of its SLA deadline.
SLA_AT_RISK_WINDOW_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=support@example.com
SLACK_WEBHOOK_URL=

# Phase 5: agent productivity. PRESENCE_WINDOW_SECONDS is how recent a
# collision-detection heartbeat must be to count as an active viewer.
# REPLY_DRAFT_SIMILAR_LIMIT is how many recent resolved tickets in the same
# category feed the LLM reply drafter as context (LLM draft also needs
# ANTHROPIC_API_KEY; it degrades to no-draft when unset).
PRESENCE_WINDOW_SECONDS=60
REPLY_DRAFT_SIMILAR_LIMIT=3
